rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 앱 관리자 (admin/config의 uids)
    function isAppAdmin() {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/admin/config).data.uids;
    }
    // 커뮤니티 관리자 (커뮤니티를 만들었거나 승계받은 사람)
    function isCommunityAdmin(communityId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/communities/$(communityId)).data.get('createdBy', null) == request.auth.uid;
    }
    // 글쓴이 본인 (기존 문서의 field 값이 내 uid)
    function isOwner(field) {
      return request.auth != null && resource.data.get(field, null) == request.auth.uid;
    }
    // 새로 만드는 문서의 field 값이 내 uid (남의 이름으로 작성 방지)
    function isCreator(field) {
      return request.auth != null && request.resource.data.get(field, null) == request.auth.uid;
    }
    // 이 커뮤니티 멤버 (멤버 문서 id = 내 uid)
    function isMember(communityId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }
    // 이번 수정에서 바뀌는 필드가 keys 안에만 있음
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // 커뮤니티 초대 코드·비밀번호 (2026-11-01~ private/secret, 멤버만 읽음).
    // 아직 옮기지 않은 옛 커뮤니티는 커뮤니티 문서에 그대로 있다.
    function communitySecret(communityId) {
      let p = /databases/$(database)/documents/communities/$(communityId)/private/secret;
      return exists(p) ? get(p).data
        : get(/databases/$(database)/documents/communities/$(communityId)).data;
    }
    // 가입 확인: 공개 커뮤니티가 아니면 초대 코드(joinCode), 비밀번호가 있으면 비밀번호(joinKey)가 맞아야 함.
    // 예전엔 비밀번호를 화면에서만 확인해서, 로그인한 누구나 비밀번호를 읽고 바로 가입할 수 있었다.
    function canJoin(communityId) {
      let comm = get(/databases/$(database)/documents/communities/$(communityId)).data;
      let s = communitySecret(communityId);
      let code = s.get('inviteCode', null);
      let pw = s.get('password', null);
      let codeOk = comm.get('isPublic', false) == true
        || (code != null && request.resource.data.get('joinCode', null) == code);
      let pwOk = pw == null || pw == ''
        || string(request.resource.data.get('joinKey', '')) == string(pw);
      return codeOk && pwOk;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/admin/config).data.uids;
    }
    match /admin/config {
      allow read: if request.auth != null;
    }
    match /rankings/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    match /communities/{communityId} {
      allow read: if request.auth != null;
      // 만드는 사람이 곧 관리자(createdBy)여야 함 — 남을 관리자로 지정해서 만들 수 없음
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      // 일반 멤버는 인원수(memberCount)·최근활동(lastActivityAt)만 변경 가능.
      // 관리자 승계(createdBy)·암호·이름 등 나머지는 현재 관리자 또는 앱 관리자만 변경 가능.
      allow update: if request.auth != null && (
        resource.data.get('createdBy', null) == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/admin/config).data.uids
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'lastActivityAt'])
      );
      allow delete: if request.auth.uid in
        get(/databases/$(database)/documents/admin/config).data.uids;
      // 초대 코드·비밀번호: 멤버·앱 관리자만 읽고, 커뮤니티 관리자·앱 관리자만 바꾼다.
      match /private/secret {
        allow read: if isMember(communityId) || isAppAdmin();
        allow write: if isCommunityAdmin(communityId) || isAppAdmin();
      }
      // 멤버: 읽기는 멤버·앱 관리자(내 멤버 문서는 가입 전 확인용으로 본인도).
      // 가입은 본인 것만, 초대 코드·비밀번호 확인(canJoin) — 만든 사람·앱 관리자는 확인 없이.
      // 수정·삭제(탈퇴)는 본인 또는 커뮤니티 관리자·앱 관리자
      match /members/{userId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || isMember(communityId) || isAppAdmin());
        allow create: if request.auth != null && request.auth.uid == userId
          && (isCommunityAdmin(communityId) || isAppAdmin() || canJoin(communityId));
        allow update, delete: if (request.auth != null && request.auth.uid == userId)
          || isCommunityAdmin(communityId) || isAppAdmin();
      }
      // 아래 커뮤니티 내용(일정·출석·공지·게시판)은 멤버·앱 관리자만 읽고, 멤버만 쓴다 (2026-11-01).
      // 일정: 만든 사람(createdBy) 명의로만 생성. 수정·삭제는 만든 사람 또는 커뮤니티 관리자·앱 관리자
      match /events/{eventId} {
        allow read: if isMember(communityId) || isAppAdmin();
        allow create: if isCreator('createdBy') && isMember(communityId);
        allow update, delete: if isOwner('createdBy') || isCommunityAdmin(communityId) || isAppAdmin();
      }
      // 출석: 본인 기록만 생성·수정. 삭제는 본인 또는 커뮤니티 관리자·앱 관리자
      match /checkins/{userId} {
        allow read: if isMember(communityId) || isAppAdmin();
        allow create: if request.auth != null && request.auth.uid == userId && isMember(communityId);
        allow update, delete: if (request.auth != null && request.auth.uid == userId)
          || isCommunityAdmin(communityId) || isAppAdmin();
      }
      // 공지·게시글: 본인 명의(uid)로만 작성. 수정·삭제는 글쓴이 또는 커뮤니티 관리자·앱 관리자.
      // 다른 멤버는 댓글 수(commentCount)만 변경 가능(댓글 달기·지우기).
      // 댓글: 본인 명의로만 작성. 수정·삭제는 글쓴이 또는 관리자, 다른 멤버는 좋아요(likedBy)만 변경 가능.
      match /notices/{noticeId} {
        allow read: if isMember(communityId) || isAppAdmin();
        allow create: if isCreator('uid') && isMember(communityId);
        allow update: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin()
          || (isMember(communityId) && onlyChanges(['commentCount']));
        allow delete: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin();
        match /comments/{commentId} {
          allow read: if isMember(communityId) || isAppAdmin();
          allow create: if isCreator('uid') && isMember(communityId);
          allow update: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin()
            || (isMember(communityId) && onlyChanges(['likedBy']));
          allow delete: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin();
        }
      }
      // 단체 채팅: 읽기·보내기는 멤버만(본인 명의로만). 삭제는 보낸 사람 또는 커뮤니티 관리자·앱 관리자. 수정 없음.
      match /chat/{messageId} {
        allow read: if isMember(communityId) || isAppAdmin();
        allow create: if isCreator('uid') && isMember(communityId);
        allow delete: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin();
      }
      match /board/{postId} {
        allow read: if isMember(communityId) || isAppAdmin();
        allow create: if isCreator('uid') && isMember(communityId);
        allow update: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin()
          || (isMember(communityId) && onlyChanges(['commentCount']));
        allow delete: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin();
        match /comments/{commentId} {
          allow read: if isMember(communityId) || isAppAdmin();
          allow create: if isCreator('uid') && isMember(communityId);
          allow update: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin()
            || (isMember(communityId) && onlyChanges(['likedBy']));
          allow delete: if isOwner('uid') || isCommunityAdmin(communityId) || isAppAdmin();
        }
      }
    }
    // 초대 코드 → 커뮤니티 찾기 (문서 id = 코드). 코드를 아는 사람만 하나씩 조회, 목록 조회 불가.
    // 만들기·지우기는 그 커뮤니티 관리자·앱 관리자만.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['communityId'])
        && (isCommunityAdmin(request.resource.data.communityId) || isAppAdmin());
      allow delete: if request.auth != null
        && (isCommunityAdmin(resource.data.communityId) || isAppAdmin());
    }
    // 자유게시판 (전체 공개, 커뮤니티 소속 무관) — 작성은 본인 명의로만.
    // 수정·삭제는 글쓴이 또는 앱 관리자. 다른 사람은 댓글 수·좋아요만 변경 가능.
    match /publicBoard/{postId} {
      allow read: if request.auth != null;
      allow create: if isCreator('uid');
      allow update: if isOwner('uid') || isAppAdmin()
        || (request.auth != null && onlyChanges(['commentCount']));
      allow delete: if isOwner('uid') || isAppAdmin();
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if isCreator('uid');
        allow update: if isOwner('uid') || isAppAdmin()
          || (request.auth != null && onlyChanges(['likedBy']));
        allow delete: if isOwner('uid') || isAppAdmin();
      }
    }
    // 앱 오류 기록: 로그인한 사용자가 본인 명의로 정해진 칸만 짧게 남김. 읽기·지우기는 앱 관리자만.
    match /errorLogs/{logId} {
      allow create: if isCreator('uid')
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'msg', 'stack', 'where', 'version', 'platform', 'at'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 600
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000;
      allow read, delete: if isAppAdmin();
    }
    match /suggestions/{suggestionId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/admin/config).data.uids;
    }
    // 앱 잠금 해제 표시 (문서 id = 그 기기의 잠금 id). 만들기는 앱 관리자만(본인 확인 후),
    // 잠긴 기기의 본인은 확인(없는 문서 확인 포함)·사용 후 지우기만. 수정은 없음.
    match /appLockResets/{lockId} {
      allow create: if isAppAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid is string;
      allow get: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if isOwner('uid') || isAppAdmin();
    }
    // 챌린지: 만든 사람(hostUid)·앱 관리자만 수정. 다른 사람은 참여 인원수(memberCount)만.
    // 삭제는 앱 관리자만(관리자 화면 — 커뮤니티와 같음).
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if isCreator('hostUid');
      allow update: if isOwner('hostUid') || isAppAdmin()
        || (request.auth != null && onlyChanges(['memberCount']));
      allow delete: if isAppAdmin();
      // 참여자: 문서 id = 본인 uid. 참여·습관 연결·연속 기록은 본인만, 정리(삭제)는 본인 또는 앱 관리자
      match /members/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && (request.auth.uid == userId || isAppAdmin());
      }
      // 인증: 본인 명의로만 작성. 수정·삭제는 본인·앱 관리자, 다른 사람은 응원 수(cheerCount)만
      match /certs/{certId} {
        allow read: if request.auth != null;
        allow create: if isCreator('uid');
        allow update: if isOwner('uid') || isAppAdmin()
          || (request.auth != null && onlyChanges(['cheerCount']));
        allow delete: if isOwner('uid') || isAppAdmin();
      }
    }
    // 텔레그램 연결 코드: 본인 것만 만들기. 쓰고 지우는 건 서버(봇)가 한다 — 예전엔 누구나 지울 수 있었다.
    match /tg_connect/{code} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /tg_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
