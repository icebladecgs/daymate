{
  "name": "daymate-desktop",
  "version": "1.3.6",
  "description": "Daymate Desktop App",
  "author": "icebladecgs",
  "main": "main.js",
  "scripts": {
    "start": "node launcher.js",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.daymate.desktop",
    "productName": "Daymate",
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
