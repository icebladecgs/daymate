{
  "crons": [
    { "path": "/api/notify-dispatch",      "schedule": "*/5 * * * *" },
    { "path": "/api/notify?type=invest-review", "schedule": "0 0 * * *" },
    { "path": "/api/briefing",             "schedule": "0 21 * * *" }
  ],
  "functions": {
    "api/chat.js": { "includeFiles": "api/_data/**" },
    "api/briefing.js": { "maxDuration": 120 }
  },
  "routes": [
    { "src": "/api/telegram-webhook", "dest": "/api/telegram-webhook.js" }
  ]
}
